---
import Layout from "./Layout.astro";
import Metatags from "../components/Metatags.astro";
import { format } from "date-fns";
import { cloudinaryImageBaseUrl } from "../constants";

const { frontmatter } = Astro.props;
const mainImgSrc =
  frontmatter.mainImageUrl ??
  `${cloudinaryImageBaseUrl}/c_fill,w_1000,ar_16:9/q_auto/${frontmatter.cloudinaryImageFileName}`;
---

<Layout title={frontmatter.title}>
  <Metatags
    slot="metatags"
    image={mainImgSrc}
    description={frontmatter.description}
    site_name="Agile Gadgets"
    title={frontmatter.title}
    url={"https://agilegadgets.com" + frontmatter.url}
  />
  <article class="blog-post">
    <header>
      <img src={mainImgSrc} alt="" />

      <h1>{frontmatter.title}</h1>
      <div class="metadata">
        <time datetime={frontmatter.pubDate}>
          {format(new Date(frontmatter.pubDate), "MMMM d, yyyy")}
        </time>
        {frontmatter.author && <span class="author">by {frontmatter.author}</span>}
      </div>
    </header>
    <div class="content">
      <slot />
    </div>
  </article>
</Layout>

<script>
  import mermaid from 'mermaid';
  mermaid.initialize({ startOnLoad: false });

  document.querySelectorAll('pre[data-language="mermaid"]').forEach((pre) => {
    const source = pre.querySelector('code')?.textContent?.trim() ?? '';
    const div = document.createElement('div');
    div.className = 'mermaid';
    div.textContent = source;
    pre.replaceWith(div);
  });

  await mermaid.run({ querySelector: '.mermaid' });
</script>

<style>
  .blog-post {
    font-family: Menlo, Arial, sans-serif;
    max-width: 65ch;
    margin: 0 auto;
    padding: 2rem;

    header {
      margin-bottom: 2rem;

      img {
        width: 100%;
      }
      h1 {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
      }
      .metadata {
        color: light-dark(var(--dark1), var(--lite1));
        font-size: 0.9rem;
      }

      .author {
        margin-left: 0.25rem;
      }
    }

    .content {
      color: light-dark(var(--dark1), var(--lite1));
      line-height: 1.7;

      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        color: light-dark(var(--dark2), var(--lite2));
      }

      img {
        max-width: 100%; /* Ensures the image does not exceed the width of its container */
        height: auto; /* Maintains the aspect ratio */
      }

    }
  }

  /* .content :global(h2) {
    font-size: 1.8rem;
    margin: 2rem 0 1rem;
  }

  .content :global(p) {
    margin-bottom: 1.5rem;
  }

  .content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
  }

  .content :global(code) {
    background: rgba(var(--lite2), 12%);
    color: rgb(var(--lite2));
    padding: 0.2em 0.4em;
    border-radius: 0.25rem;
    font-size: 0.9em;
  } */

  /* Table styling */
  .content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-family: system-ui, Arial, sans-serif;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .content :global(th),
  .content :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 20%, transparent);
  }

  .content :global(th) {
    border-bottom-width: 2px;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .content :global(td:first-child) {
    min-width: 7rem;
  }

  .content :global(td code) {
    font-size: 0.85em;
    background: color-mix(in srgb, currentColor 10%, transparent);
    padding: 0.1em 0.35em;
    border-radius: 0.25rem;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
</style>
